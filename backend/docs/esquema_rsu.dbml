// ==========================================================================
// SISTEMA WEB DE GESTION RSU - NexTera
// Universidad Nacional de San Agustin de Arequipa (UNSA)
// Esquema DBML generado por introspeccion de los modelos Django
// Rama backend-rsu - hasta Sprint 6 (HU-06)
//
// Los nombres de tabla y de columna son los FISICOS de PostgreSQL,
// tal como los declara el codigo (Meta.db_table y el nombre de columna).
//
// Sprint 6 (HU-06) no agrega ni modifica ninguna tabla: los informes
// consolidados se resuelven por consulta sobre este mismo esquema.
// ==========================================================================

// ==========================================================================
// SPRINT 1-2: USUARIOS, ROLES Y ESTRUCTURA ACADEMICA  (apps/usuarios)
// ==========================================================================

Table roles {
  id bigint [pk, increment]
  nombre varchar(50) [not null, unique, note: 'Administrador | Docente | Departamento | Jefatura RSU']
  descripcion varchar(255) [not null]
  activo boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table facultades {
  id bigint [pk, increment]
  nombre varchar(200) [not null]
  codigo varchar(20) [unique]
  created_at timestamp [not null, default: `now()`]
}

Table escuelas_profesionales {
  id bigint [pk, increment]
  nombre varchar(200) [not null]
  codigo varchar(20) [unique]
  facultad_id bigint [not null]
  created_at timestamp [not null, default: `now()`]
}

Table departamentos_academicos {
  id bigint [pk, increment]
  nombre varchar(200) [not null]
  codigo varchar(20) [unique]
  facultad_id bigint [not null]
  created_at timestamp [not null, default: `now()`]
}

Table usuarios {
  id bigint [pk, increment]
  password varchar(128) [not null]
  last_login timestamp
  is_superuser boolean [not null, default: false, note: 'Indica que este usuario tiene todos los permisos sin asignárselos explícitamente.']
  nombres varchar(150) [not null]
  apellidos varchar(100) [not null]
  correo_institucional varchar(254) [not null, unique]
  celular varchar(20)
  rol_id bigint
  facultad_id bigint
  escuela_id bigint
  departamento_id bigint
  estado varchar(20) [not null, default: 'activo', note: 'activo | inactivo']
  is_active boolean [not null, default: true, note: 'Indica si el usuario puede hacer login']
  firma_digital varchar(100) [note: 'Firma digital del usuario (JPG/PNG). archivo en media/firmas/']
  is_staff boolean [not null, default: false]
  ultimo_acceso timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  note: 'AUTH_USER_MODEL. El login es por correo institucional. password, last_login e is_superuser los aporta AbstractBaseUser/PermissionsMixin.'
}

Table sesiones {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  token varchar(500) [not null, unique]
  expira_en timestamp [not null]
  ip_address varchar(39)
  created_at timestamp [not null, default: `now()`]
}

Table historial_roles_usuario {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  cambiado_por_id bigint
  rol_anterior_id bigint
  rol_nuevo_id bigint [not null]
  motivo varchar(500) [not null]
  created_at timestamp [not null, default: `now()`]
}

Table auditoria_usuarios {
  id bigint [pk, increment]
  ejecutado_por_id bigint
  usuario_afectado_id bigint
  accion varchar(50) [not null, note: 'CREAR | EDITAR | ACTIVAR | DESACTIVAR | CAMBIAR_ROL']
  detalle text [not null]
  ip_address varchar(39)
  created_at timestamp [not null, default: `now()`]
}

Table usuarios_groups {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  group_id bigint [not null]

  indexes {
    (usuario_id, group_id) [unique]
  }

  note: 'Tabla intermedia generada por Django (PermissionsMixin). No se administra desde la aplicacion RSU.'
}

Table usuarios_user_permissions {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  permission_id bigint [not null]

  indexes {
    (usuario_id, permission_id) [unique]
  }

  note: 'Tabla intermedia generada por Django (PermissionsMixin). No se administra desde la aplicacion RSU.'
}

// ==========================================================================
// SPRINT 2: PLANIFICACION - MATRIZ OPERATIVA  (apps/planificacion)
// ==========================================================================

Table periodos_academicos {
  id bigint [pk, increment]
  nombre varchar(100) [not null]
  anio int [not null]
  semestre varchar(10) [not null, note: 'I | II | Anual']
  fecha_inicio date [not null]
  fecha_fin date [not null]
  activo boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (anio, semestre) [unique, name: "unique_periodo_anio_semestre"]
  }

  note: 'Restriccion de unicidad por (anio, semestre).'
}

Table ejes_rsu {
  id bigint [pk, increment]
  nombre varchar(100) [not null, unique]
  descripcion text
  created_at timestamp [not null, default: `now()`]
}

Table ejes_rsu_subitems {
  id bigint [pk, increment]
  eje_rsu_id bigint [not null]
  clave varchar(100) [not null]
  nombre varchar(500) [not null]
  requiere_detalle boolean [not null, default: false]
  label_detalle varchar(200) [not null]
  orden int [not null, default: 0]

  indexes {
    (eje_rsu_id, clave) [unique]
  }

  note: 'Clave unica compuesta (eje_rsu_id, clave).'
}

Table ods {
  id bigint [pk, increment]
  numero int [not null, unique]
  nombre varchar(200) [not null]
  descripcion text
  icono_url varchar(500)
  created_at timestamp [not null, default: `now()`]
}

Table lineas_estrategicas {
  id bigint [pk, increment]
  nombre varchar(200) [not null]
  descripcion text
  eje_rsu_id bigint [not null]
  created_at timestamp [not null, default: `now()`]
}

Table matrices_operativas {
  id bigint [pk, increment]
  periodo_id bigint [not null]
  facultad_id bigint [not null]
  coordinador_id bigint [not null]
  presupuesto_global decimal(12,2)
  estado varchar(30) [not null, default: 'borrador', note: 'borrador | publicada | cerrada']
  observaciones text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table objetivos_institucionales {
  id bigint [pk, increment]
  matriz_id bigint [not null]
  linea_estrategica_id bigint
  eje_rsu_id bigint [not null]
  nombre varchar(300) [not null]
  descripcion text
  resultado_esperado text
  meta_cuantitativa varchar(300)
  created_at timestamp [not null, default: `now()`]
}

Table indicadores_institucionales {
  id bigint [pk, increment]
  objetivo_id bigint [not null]
  nombre varchar(300) [not null]
  unidad_medida varchar(100)
  valor_meta decimal(10,2)
  valor_alcanzado decimal(10,2)
  metodo_verificacion text
  created_at timestamp [not null, default: `now()`]
}

Table actividades_sugeridas {
  id bigint [pk, increment]
  matriz_id bigint [not null]
  objetivo_id bigint
  eje_rsu_id bigint [not null]
  nombre varchar(300) [not null]
  descripcion text
  anio_academico int [note: '1 | 2 | 3 | 4 | 5']
  tipo_actividad varchar(150)
  destinatarios varchar(300)
  presupuesto_ref decimal(10,2)
  created_at timestamp [not null, default: `now()`]
}

// ==========================================================================
// SPRINT 3: PROYECTOS RSU - FORMULACION (ANEXO 4 / FORMATO OURS)  (apps/proyectos)
// ==========================================================================

Table tipo_beneficiario {
  id bigint [pk, increment]
  codigo varchar(50) [not null, unique]
  label varchar(200) [not null]
  orden smallint [not null, default: 0]
}

Table proyectos_rsu {
  id bigint [pk, increment]
  codigo varchar(50) [unique, note: 'Código asignado por la comisión OURS una vez consolidados todos los proyectos.']
  estado varchar(30) [not null, default: 'borrador', note: 'borrador | en_revision | observado | corregido | aprobado | en_ejecucion | finalizado | rechazado']
  porcentaje_ejecucion decimal(5,2) [not null, default: 0, note: '% de ejecución (0-100) calculado automáticamente según el estado de las actividades.']
  presentado_con_anticipacion boolean [not null, default: false]
  es_continuacion boolean [not null, default: false]
  proyecto_origen_id bigint
  facultad_id bigint [not null, note: '1.1 Facultad']
  escuela_id bigint [not null, note: '1.2 Escuela Profesional']
  departamento_id bigint [not null, note: '1.3 Departamento Académico']
  semestre_academico varchar(20) [not null, note: '1.4 Semestre académico (ej: 2023-A)']
  titulo varchar(400) [not null, note: '1.6 Título del proyecto']
  nro_docentes int [default: 1, note: '1.7 Nro. de docentes que participaron']
  nro_estudiantes int [default: 0, note: '1.8 Nro. de estudiantes universitarios que participaron']
  benef_otro_detalle varchar(500) [not null, note: '1.9j Detalle cuando se selecciona Otro']
  eje_rsu_id bigint [not null, note: '1.10 Eje RSU principal del proyecto (selección excluyente)']
  eje_detalle text [note: '1.10 Descripción obligatoria cuando el eje RSU seleccionado es Otros']
  linea_estrategica_id bigint
  objetivo_institucional_id bigint
  tipo_actividad json [not null, note: '1.11 Tipos de actividad seleccionados (lista, p.ej. [asesoria,otro])']
  tipo_actividad_otro varchar(300) [note: '1.11 Descripción si se seleccionó Otro como tipo de actividad']
  fecha_inicio date [note: '1.14 Fecha de inicio']
  fecha_evaluacion_avance date [note: '1.15 Fecha de evaluación de avance']
  fecha_termino date [note: '1.16 Fecha de término']
  fecha_encuesta_docentes date [note: '1.17 Encuesta a Docentes']
  fecha_encuesta_alumnos date [note: '1.17 Encuesta a Estudiantes']
  fecha_encuesta_grupo_destinatario date [note: '1.17 Encuesta a Grupo Destinatario']
  lugar_ejecucion text [note: '1.18 Lugar de ejecución (ej: Distrito de Cayma, Arequipa)']
  fund_por_que_grupo text [note: 'II ¿Por qué se eligió el grupo beneficiario?']
  fund_para_que_proyecto text [note: 'II ¿Para qué servirá el proyecto?']
  fund_mecanismo_ensenanza text [note: 'II ¿Cuál será el mecanismo de enseñanza-aprendizaje?']
  diag_estado_grupo text [note: 'III Estado actual del grupo beneficiario']
  diag_problemas_detectados text [note: 'III Problemas detectados']
  diag_aportes_formacion text [note: 'III Aportes desde la formación profesional']
  diag_justificacion_intervencion text [note: 'III Justificación de la intervención']
  obj_logro_intervencion text [note: 'IV ¿Qué queremos lograr con nuestra intervención en el grupo beneficiario?']
  obj_mejora_curricular text [note: 'IV ¿Qué queremos mejorar en el proceso curricular?']
  resultado_en_beneficiarios text [note: 'V Resultados esperados en los beneficiarios']
  resultado_en_curriculo text [note: 'V Resultados esperados en el proceso curricular']
  impacto_esperado text [note: 'V Impacto esperado general']
  rec_hum_docentes int [not null, default: 0, note: 'VIII Docentes']
  rec_hum_administrativos int [not null, default: 0, note: 'VIII Administrativos']
  rec_hum_estudiantes int [not null, default: 0, note: 'VIII Estudiantes']
  rec_hum_egresados int [not null, default: 0, note: 'VIII Egresados']
  rec_hum_voluntarios int [not null, default: 0, note: 'VIII Voluntarios']
  rec_hum_otros int [not null, default: 0, note: 'VIII Otros recursos humanos']
  rec_mat_material_didactico text [note: 'VIII Material didáctico']
  rec_mat_afiches text [note: 'VIII Afiches']
  rec_mat_equipos text [note: 'VIII Equipos']
  rec_mat_utiles text [note: 'VIII Útiles']
  rec_mat_otros text [note: 'VIII Otros materiales']
  monto_financiamiento decimal(12,2) [default: 0, note: 'IX Presupuesto estimado total (S/)']
  fuente_financiamiento varchar(50) [note: 'recursos_propios_unsa | cooperacion_externa | aporte_facultad | autofinanciado. IX Fuente de financiamiento']
  descripcion_gastos text [note: 'IX Detalle de los rubros de gasto y su distribución']
  observaciones_financiamiento text [note: 'IX Observaciones adicionales sobre el financiamiento']
  financiamiento_confirmado boolean [not null, default: false]
  financiamiento_fecha_confirmacion timestamp
  periodo_id bigint
  docente_responsable_id bigint [not null]
  anio_carrera int [note: '1 | 2 | 3 | 4 | 5']
  es_tesis_quinto_anio boolean [not null, default: false]
  conclusiones text
  recomendaciones text
  lecciones_aprendidas text
  medio_difusion varchar(200)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  fecha_envio_revision timestamp
  fecha_aprobacion timestamp
  fecha_inicio_ejecucion timestamp
  fecha_cierre timestamp

  note: 'Entidad principal. Implementa el ANEXO 4 (Formato OURS), secciones I a IX. porcentaje_ejecucion es autocalculado: actividades completadas / total x 100.'
}

Table proyecto_beneficiarios {
  id bigint [pk, increment]
  proyectorsu_id bigint [not null]
  tipobeneficiario_id bigint [not null]

  indexes {
    (proyectorsu_id, tipobeneficiario_id) [unique]
  }

  note: 'Tabla intermedia generada por Django para el M2M ProyectoRSU.beneficiarios. Par (proyectorsu_id, tipobeneficiario_id) unico.'
}

Table proyecto_ods {
  id bigint [pk, increment]
  proyectorsu_id bigint [not null]
  ods_id bigint [not null]

  indexes {
    (proyectorsu_id, ods_id) [unique]
  }

  note: 'Tabla intermedia generada por Django para el M2M ProyectoRSU.ods. Par (proyectorsu_id, ods_id) unico.'
}

Table proyecto_ejes_subitems {
  id bigint [pk, increment]
  proyecto_id bigint [not null]
  sub_eje_id bigint [not null]
  detalle text [not null, note: 'Texto adicional requerido cuando sub_eje.requiere_detalle es True']

  indexes {
    (proyecto_id, sub_eje_id) [unique]
  }

  note: 'Par (proyecto_id, sub_eje_id) unico.'
}

Table proyecto_asignaturas {
  id bigint [pk, increment]
  proyecto_id bigint [not null]
  nombre_asignatura varchar(200) [not null]
  codigo_asignatura varchar(50)
  anio_carrera int
  semestre varchar(10)
}

Table proyecto_docentes {
  id bigint [pk, increment]
  proyecto_id bigint [not null]
  docente_id bigint [not null]
  rol_en_proyecto varchar(100) [not null, note: 'Colaborador | Asesor']
}

Table proyecto_actividades {
  id bigint [pk, increment]
  proyecto_id bigint [not null]
  nombre varchar(300) [not null, note: 'Nombre de la actividad']
  descripcion text [note: 'Descripción breve']
  curso_vinculado varchar(300) [note: 'Asignatura vinculada']
  responsable varchar(200) [note: 'Responsable de la actividad']
  fecha date
  evidencia_esperada varchar(400) [note: 'Evidencia esperada (ej: Fotos, listas, informes)']
  estado varchar(20) [not null, default: 'pendiente', note: 'pendiente | en_ejecucion | completada']
  url_evidencia varchar(500) [note: 'URL de evidencia (Drive, etc.)']
  archivo_evidencia varchar(100) [note: 'Archivo de evidencia. archivo en media/evidencias_actividades/']
  orden int [not null, default: 0]

  note: 'Seccion VI del ANEXO 4. El campo estado lo actualiza el registro de avances (HU-05, CA-01) y alimenta proyectos_rsu.porcentaje_ejecucion.'
}

Table proyecto_cronograma {
  id bigint [pk, increment]
  proyecto_id bigint [not null]
  descripcion varchar(400) [not null, note: 'Descripción de la acción']
  fecha_inicio date
  fecha_fin date
  responsable varchar(200)
  estado_avance varchar(30) [not null, default: 'no_iniciado', note: 'no_iniciado | pendiente | en_proceso | finalizado']
  orden int [not null, default: 0]
}

Table proyecto_documentos_sustento {
  id bigint [pk, increment]
  proyecto_id bigint [not null]
  archivo varchar(100) [not null, note: 'archivo en media/proyectos/sustento/']
  nombre varchar(255)
  uploaded_at timestamp [not null, default: `now()`]
}

Table fuente_financiamiento_proyecto {
  id bigint [pk, increment]
  proyecto_id bigint [not null]
  fuente varchar(50) [not null, note: 'recursos_propios_unsa | cooperacion_externa | aporte_facultad | autofinanciado. Fuente de financiamiento']
  monto decimal(12,2) [not null, default: 0, note: 'Monto aportado por esta fuente (S/)']
  descripcion varchar(500) [not null, note: 'Detalle adicional sobre esta fuente']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table presupuesto_proyecto {
  id bigint [pk, increment]
  proyecto_id bigint [not null]
  categoria varchar(150) [not null, note: 'material_escritorio | refrigerio | transporte | otros. Categoría del gasto']
  tipo_recurso varchar(50) [not null, note: 'humano | material | financiero. Tipo de recurso']
  descripcion varchar(500) [not null, note: 'Descripción del rubro o concepto de gasto']
  unidad varchar(50) [not null, note: 'Unidad de medida (ej: unidad, hora, taller, kit)']
  cantidad int [not null, default: 1, note: 'Número de unidades']
  costo_unitario decimal(10,2) [not null, note: 'Costo por unidad en Soles (S/)']
  monto_ejecutado decimal(10,2) [not null, default: 0, note: 'Monto efectivamente gastado al cierre']
  fuente_id bigint [note: 'Fuente de financiamiento de este rubro']
  orden int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  note: 'El monto presupuestado se calcula como cantidad x costo_unitario; no se almacena.'
}

Table proyecto_metas_indicadores {
  id bigint [pk, increment]
  proyecto_id bigint [not null]
  meta_descripcion varchar(400) [not null, note: 'Descripción de la meta (ej: Capacitar a 50 docentes en reciclaje)']
  indicador_nombre varchar(300) [not null, note: 'Nombre del indicador de medición (ej: Nro. de docentes capacitados)']
  unidad_medida varchar(100) [not null, note: 'Unidad de medida del indicador (ej: personas, %, talleres)']
  linea_base decimal(10,2) [note: 'Valor inicial antes de la intervención (situación de partida)']
  valor_meta decimal(10,2) [note: 'Valor objetivo a alcanzar al finalizar el proyecto']
  valor_alcanzado decimal(10,2) [note: 'Valor efectivamente alcanzado — se registra durante/al cierre del proyecto']
  metodo_verificacion text [not null, note: 'Cómo se verifica el cumplimiento (ej: Lista de asistencia, Encuesta)']
  fuente_verificacion varchar(300) [not null, note: 'Documento o fuente del dato de verificación']
  orden int [not null, default: 0]
}

// ==========================================================================
// SPRINT 4: REVISION Y APROBACION (HU-04)  (apps/proyectos)
// ==========================================================================

Table revision_proyecto {
  id bigint [pk, increment]
  proyecto_id bigint [not null, note: 'Proyecto evaluado']
  revisor_id bigint [not null, note: 'Usuario con rol Departamento que emite el dictamen']
  decision varchar(20) [not null, note: 'aprobado | observado. Resultado del dictamen: aprobado | observado']
  comentario_tecnico text [not null, note: 'Obligatorio cuando la decisión es observado. Describe las correcciones requeridas.']
  estado_anterior varchar(30) [not null, note: 'Snapshot del estado del proyecto antes del dictamen']
  estado_nuevo varchar(30) [not null, note: 'Estado asignado al proyecto por este dictamen']
  created_at timestamp [not null, default: `now()`, note: 'Fecha y hora exacta del dictamen — inmutable']

  note: 'Un proyecto puede tener varias revisiones por los ciclos observado - corregido - revisado. comentario_tecnico es obligatorio si decision = observado.'
}

Table historial_estado_proyecto {
  id bigint [pk, increment]
  proyecto_id bigint [not null, note: 'Proyecto cuyo estado cambió']
  usuario_id bigint [not null, note: 'Usuario que realizó el cambio de estado']
  estado_anterior varchar(30) [not null, note: 'Estado previo del proyecto']
  estado_nuevo varchar(30) [not null, note: 'Nuevo estado asignado']
  comentario text [not null, note: 'Motivo del cambio, observación técnica, etc.']
  ip_address varchar(39) [note: 'IP del cliente que realizó la acción']
  created_at timestamp [not null, default: `now()`, note: 'Timestamp inmutable del cambio de estado']

  note: 'Bitacora de solo insercion de todos los cambios de estado.'
}

Table notificaciones {
  id bigint [pk, increment]
  destinatario_id bigint [not null, note: 'Usuario que recibe la notificación (docente responsable)']
  proyecto_id bigint [note: 'Proyecto al que hace referencia la notificación']
  tipo varchar(50) [not null, note: 'aprobacion | observacion | envio_revision | correccion | avance_observado | avance_corregido. Tipo de evento que originó la notificación']
  titulo varchar(300) [not null, note: 'Título breve de la notificación']
  mensaje text [not null, note: 'Detalle completo: resultado, evaluador, fecha, comentario técnico si aplica']
  leida boolean [not null, default: false, note: 'Si el destinatario ya leyó la notificación']
  leida_en timestamp [note: 'Timestamp cuando fue marcada como leída']
  created_at timestamp [not null, default: `now()`]
}

// ==========================================================================
// SPRINT 5: SEGUIMIENTO Y EJECUCION (HU-05)  (apps/proyectos)
// ==========================================================================

Table proyecto_avances {
  id bigint [pk, increment]
  proyecto_id bigint [not null]
  actividad_id bigint [not null]
  descripcion text [not null, note: 'Descripción del avance realizado.']
  estado_actividad varchar(20) [not null, note: 'pendiente | en_ejecucion | completada. Estado que se fija a la actividad con este avance.']
  observaciones text [note: 'Observaciones del docente (opcional).']
  estado_revision varchar(20) [not null, default: 'registrado', note: 'registrado | observado | corregido']
  comentario_revision text [note: 'Comentario del revisor al observar el avance.']
  autor_id bigint [not null, note: 'Docente responsable que registró el avance.']
  revisor_id bigint [note: 'Usuario que observó el avance (Jefatura RSU/Departamento/Admin).']
  created_at timestamp [not null, default: `now()`]
  revisado_en timestamp

  note: 'HU-05 (T-86/T-90). Historial de solo insercion: no se edita ni se elimina (CA-06).'
}

Table proyecto_evidencias {
  id bigint [pk, increment]
  avance_id bigint [not null]
  tipo varchar(10) [not null, note: 'archivo | enlace']
  archivo varchar(100) [note: 'archivo en media/proyectos/evidencias/']
  enlace_drive varchar(200)
  nombre varchar(255)
  eliminada boolean [not null, default: false]
  eliminada_en timestamp
  uploaded_at timestamp [not null, default: `now()`]

  note: 'HU-05 (T-87). Archivo (PDF/JPG/JPEG/PNG, max 10 MB) o enlace de Google Drive. Borrado logico mediante eliminada / eliminada_en.'
}

// ==========================================================================
// TABLAS PROPIAS DE DJANGO REFERENCIADAS POR EL ESQUEMA
// ==========================================================================

Table auth_group {
  id int [pk, increment]
  name varchar(150) [not null, unique]

  note: 'Grupos de permisos de django.contrib.auth. No se administra desde la aplicacion RSU.'
}

Table auth_permission {
  id int [pk, increment]
  name varchar(255) [not null]
  content_type_id int [not null]
  codename varchar(100) [not null]

  note: 'Permisos de django.contrib.auth. No se administra desde la aplicacion RSU.'
}

