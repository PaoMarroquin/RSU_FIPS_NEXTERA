POSTGRES_DB=rsu_db
POSTGRES_USER=rsu_user
POSTGRES_PASSWORD=rsu_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=cambia_esto_por_una_clave_segura
DJANGO_DEBUG=True
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
MEDIA_ROOT=

# Seguridad (opcionales; valores por defecto entre paréntesis)
# Intentos de inicio de sesión por IP (10/min)
LOGIN_THROTTLE_RATE=10/min
# Vigencia de las URLs firmadas de archivos, en segundos (7200)
MEDIA_URL_EXPIRACION_SEGUNDOS=7200
# disco | bd | supabase  (MEDIA_EN_BD=True sigue funcionando como antes)
MEDIA_BACKEND=disco

# Solo se leen si MEDIA_BACKEND=supabase (o al correr migrate_supabase.py)
SUPABASE_S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_KEY_ID=
SUPABASE_S3_SECRET=
SUPABASE_BUCKET=rsu-media