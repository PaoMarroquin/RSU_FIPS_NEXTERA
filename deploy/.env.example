# Copiar como deploy/.env y completar. No subir el .env al repositorio.

# Dominio público (sin barra final)
URL_PUBLICA=https://rsu-fips.unsa.edu.pe

# Base de datos (solo red interna de Docker)
POSTGRES_DB=rsu_fips
POSTGRES_USER=rsu_fips
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-aleatoria-de-50-caracteres
ALLOWED_HOSTS=rsu-fips.unsa.edu.pe
CSRF_TRUSTED_ORIGINS=https://rsu-fips.unsa.edu.pe
CORS_ALLOWED_ORIGINS=https://rsu-fips.unsa.edu.pe

# Inicio de sesión con la cuenta institucional
GOOGLE_CLIENT_ID=

# Opcionales
LOGIN_THROTTLE_RATE=10/min
MEDIA_URL_EXPIRACION_SEGUNDOS=7200
